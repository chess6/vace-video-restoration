{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sdpose_wholebody_fp16.safetensors"
    },
    "_meta": {
      "title": "SDPose whole-body"
    }
  },
  "2": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "pose_source.mp4"
    },
    "_meta": {
      "title": "Source chunk"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Source frames"
    }
  },
  "4": {
    "class_type": "SDPoseKeypointExtractor",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "vae": [
        "1",
        2
      ],
      "image": [
        "3",
        0
      ],
      "batch_size": 8
    },
    "_meta": {
      "title": "Extract whole-body keypoints"
    }
  },
  "5": {
    "class_type": "SDPoseDrawKeypoints",
    "inputs": {
      "keypoints": [
        "4",
        0
      ],
      "draw_body": true,
      "draw_hands": true,
      "draw_face": true,
      "draw_feet": true,
      "draw_head": true,
      "stick_width": 4,
      "face_point_size": 3,
      "score_threshold": 0.3
    },
    "_meta": {
      "title": "Render skeleton"
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "fps": 16.0
    },
    "_meta": {
      "title": "Assemble frames"
    }
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "pose/wholebody",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save pose control"
    }
  }
}