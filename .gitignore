# ---- Secrets ----------------------------------------------------------------
# Never tracked, and never echoed into a log or a report either. A token that
# reaches the remote cannot be un-published; it has to be revoked.
.env
.env.*
*.pem
*_api_key
.hf_token

# ---- Environments & installed software -------------------------------------
venv/
ComfyUI/
models_staging/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- Model weights (large, re-downloadable via scripts/download_models.sh) --
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.onnx

# ---- Source media: NEVER commit, and NEVER modify ---------------------------
# Deny the whole inputs tree first, then re-allow only the two generic docs and
# the directory placeholders. Nothing that names, describes or derives from the
# user's media may ever reach a remote.
inputs/**
!inputs/
!inputs/source/
!inputs/references/
!inputs/subject_seeds/
!inputs/source/.gitkeep
!inputs/references/.gitkeep
!inputs/subject_seeds/.gitkeep
!inputs/source/README.md
!inputs/references/README.md

# ---- Conditioning text: never committed --------------------------------------
# The prompt that reaches the text encoder describes the subject in order to work,
# and a description precise enough to condition a model is precise enough to
# identify what was conditioned. The tracked configs carry a category-free default
# that runs; the wording actually used lives here, untracked, and load_config
# overlays it. Same for the LoRA trigger token, which is a name by construction.
configs/prompt.local.yaml

# ---- Backend bindings: never committed -------------------------------------
# Which pretrained model resolves the anchor, which parser supplies the attribute
# label map, which backend supplies structure keypoints. A model is named after
# what it was trained to find, so publishing the name publishes the category the
# rest of this file exists to withhold. scripts/backends.py loads these by role
# and fails loud when a role has no safe default.
configs/backends.local.yaml

# ---- The guard's own vocabulary: never committed -----------------------------
# check_repo_clean.sh checks 6 and 6b work from a list of forbidden words, and
# that list is a negative image of the subject: read it and you know exactly what
# is being protected, without needing any other file. The machinery stays tracked
# and the words live here.
configs/vocab.local.txt

# Archives dropped anywhere in the project
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Any media file, wherever it lands
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.mpg
*.mpeg
*.ts
*.wmv
*.flv
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.tif
*.tiff
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.DS_Store

# ---- Generated intermediates & outputs --------------------------------------
intermediate/*
!intermediate/**/.gitkeep
outputs/*
!outputs/**/.gitkeep
logs/*
!logs/.gitkeep

# Per-source run namespaces (VACE_RUN=<name>). Same content as the four
# directories above - intermediate, outputs, reports and logs for one source
# video - so it is denied on the same grounds, including the derived reports.
runs/

# ---- Agent tooling -----------------------------------------------------------
# .claude/settings.json IS tracked: it carries the rule-2c deny rules and the
# PreToolUse hook registration, and check 8 verifies a clone arrives with them.
# settings.local.json is not. It accretes literal approved command lines, and
# those have carried input filenames as arguments.
.claude/settings.local.json

# ---- Caches ------------------------------------------------------------------
.cache/
hf_cache/

# ---- Reports ------------------------------------------------------------------
# Reports DERIVED FROM THE USER'S MEDIA are never committed: they can contain
# filenames, durations, resolutions, scene structure and per-shot detail.
reports/source_info.json
reports/source_info.md
reports/tracking_report.json
reports/assembly.json
reports/assembly_pilot.json
reports/upscaler_comparison.json
reports/pilot_results_filled.md

# Machine/architecture reports ARE committed on purpose, as review material:
#   environment.md  versions.md  runtime_estimates.md  selftest.md
#   benchmark.json  mask_polarity.json  smoke_test.json  pilot_results.md (template)

# ==== Explicitly TRACKED (small, human-authored) =============================
# scripts/**, configs/**, workflows/**, README.md, CLAUDE.md, NEEDS_USER.md.
# These are NOT re-included with a blanket "!scripts/**": such a rule would
# override the __pycache__ and *.pyc rules above and commit build artefacts.
# Nothing ignores those directories in the first place, so no exception is needed.

# Belt and braces: never commit compiled Python, wherever it appears.
**/__pycache__/
**/*.pyc
